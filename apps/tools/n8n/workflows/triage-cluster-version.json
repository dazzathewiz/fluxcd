{
  "id": "TriageClusterV01",
  "name": "PR triage: cluster read (unsaved)",
  "nodes": [
    {
      "id": "0b7c1d8e-0201-4a00-9000-000000000201",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {},
      "notes": "The poll calls with no cluster_path (GET /version); the watcher passes cluster_path."
    },
    {
      "id": "0b7c1d8e-0205-4a00-9000-000000000205",
      "name": "Allowed path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "notes": "Rejects any path outside the allowlist before the token is read.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The only reads this workflow makes. A caller that sends no cluster_path\n// gets GET /version (the poll's R4 call). Anything else must match one of\n// these templates, with {ns} and {name} DNS labels, or nothing is read: the\n// token isn't touched and no request is made.\nconst TEMPLATES = [\n  '/version',\n  '/apis/kustomize.toolkit.fluxcd.io/v1/namespaces/flux-system/kustomizations/{name}',\n  '/apis/helm.toolkit.fluxcd.io/v2/namespaces/{ns}/helmreleases/{name}',\n  '/apis/apps/v1/namespaces/{ns}/deployments/{name}',\n  '/apis/apps/v1/namespaces/{ns}/statefulsets/{name}',\n];\nconst LABEL = '[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?';\nconst j = $input.first().json || {};\nconst path = Object.prototype.hasOwnProperty.call(j, 'cluster_path') ? j.cluster_path : '/version';\nconst allowed = typeof path === 'string' && TEMPLATES.some((t) => new RegExp('^' + t.replace(/[.]/g, '\\\\.').replace('{ns}', LABEL).replace('{name}', LABEL) + '$').test(path));\nreturn [{ json: { allowed, path: allowed ? path : null } }];\n"
      }
    },
    {
      "id": "0b7c1d8e-0206-4a00-9000-000000000206",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "0b7c1d8e-0206-4a00-9000-0000000002a1",
              "leftValue": "={{ $json.allowed === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0b7c1d8e-0202-4a00-9000-000000000202",
      "name": "Read service-account token",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ],
      "notes": "Kubelet rotates this file; it is read fresh on every call. Allowed by N8N_RESTRICT_FILE_ACCESS_TO.",
      "parameters": {
        "operation": "read",
        "fileSelector": "/var/run/secrets/kubernetes.io/serviceaccount/token",
        "options": {}
      }
    },
    {
      "id": "0b7c1d8e-0203-4a00-9000-000000000203",
      "name": "Token as text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        880,
        200
      ],
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "destinationKey": "data",
        "options": {}
      }
    },
    {
      "id": "0b7c1d8e-0204-4a00-9000-000000000204",
      "name": "GET",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "notes": "Last node: its output (status and body only, no binary) is all the caller receives.",
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://kubernetes.default.svc' + $('Allowed path').first().json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ String($json.data || '').trim() }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "0b7c1d8e-0207-4a00-9000-000000000207",
      "name": "Rejected",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        420
      ],
      "notes": "Last node on a rejected path: no request was made.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Not an allowed read: nothing was sent.\nreturn [{ json: { statusCode: null, rejected: true } }];"
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Allowed path",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Allowed path": {
      "main": [
        [
          {
            "node": "Allowed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Allowed?": {
      "main": [
        [
          {
            "node": "Read service-account token",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read service-account token": {
      "main": [
        [
          {
            "node": "Token as text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token as text": {
      "main": [
        [
          {
            "node": "GET",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "pinData": {},
  "active": false
}
